# ==============================================================================
# Kerala Wood Billing - Backend Environment Example Template
# Duplicate this file as .env and fill in the values
# ==============================================================================

# Server Port
PORT=5031

# Environment Mode (development / production)
NODE_ENV=development

# Allowed Frontend Origins (Comma-separated for CORS)
FRONTEND_URL=http://localhost:5173,https://keralawoods-billing.gemshine.tech

# MongoDB Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/kerala_wood_billing
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/kerala_wood_billing?retryWrites=true&w=majority
